{
  "name": "webapp",
  "version": "1.0.0",
  "description": "Desk Air Monitor — Vite web UI; optional Electron desktop (see install:web).",
  "main": "main.js",
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "install:web": "npm install --omit=optional",
    "electron": "electron .",
    "dist-app": "vite build && electron-builder"
  },
  "dependencies": {
    "@mediapipe/pose": "0.5.1675469404",
    "@vitejs/plugin-react": "^6.0.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sharp": "^0.34.5",
    "sqlite3": "^6.0.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "vite": "^8.0.10",
    "wait-on": "^8.0.0"
  },
  "optionalDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.deskairmonitor.app",
    "productName": "Desk Air Monitor",
    "files": [
      "dist/**/*",
      "main.js",
      "package.json"
    ],
    "linux": {
      "target": "AppImage"
    }
  }
}
